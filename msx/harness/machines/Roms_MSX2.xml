<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>
  <!-- The Philips NMS 8250 config on the MSX2.ROM and MSX2EXT.ROM in
       msx/roms/ (the same dumps openMSX lists for the 8245/8250/8255),
       without its disk drive: the DISK.ROM there is a dump openMSX
       does not know, and a disk ROM takes work RAM under $F380, which
       is the MSX-DOS step's problem. -->
  <info>
    <manufacturer>MSX Desk</manufacturer>
    <code>Roms MSX2</code>
    <release_year>1986</release_year>
    <description>Philips NMS 8250 without the drive, on the BIOS in msx/roms.</description>
    <type>MSX2</type>
    <region>eu</region>
  </info>
  <MapperReadBackBits>largest</MapperReadBackBits>
  <CassettePort/>
  <devices>
    <primary slot="0">
      <ROM id="MSX BIOS with BASIC ROM">
        <mem base="0x0000" size="0x8000"/>
        <rom>
          <sha1>6103b39f1e38d1aa2d84b1c3219c44f1abb5436e</sha1>
          <filename>MSX2.ROM</filename>
        </rom>
      </ROM>
    </primary>
    <primary external="true" slot="1"/>
    <primary external="true" slot="2"/>
    <primary slot="3">
      <secondary slot="0">
        <ROM id="MSX Sub ROM">
          <mem base="0x0000" size="0x10000"/>
          <rom>
            <sha1>5c1f9c7fb655e43d38e5dd1fcc6b942b2ff68b02</sha1>
            <filename>MSX2EXT.ROM</filename>
          </rom>
        </ROM>
      </secondary>
      <secondary slot="2">
        <MemoryMapper id="Main RAM">
          <mem base="0x0000" size="0x10000"/>
          <size>128</size>
        </MemoryMapper>
      </secondary>
    </primary>
    <PPI id="ppi">
      <io base="0xA8" num="8"/>
      <sound><volume>16000</volume></sound>
      <keyboard_type>int</keyboard_type>
      <has_keypad>true</has_keypad>
      <key_ghosting_sgc_protected>true</key_ghosting_sgc_protected>
      <code_kana_locks>false</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>
    <VDP id="VDP">
      <io base="0x98" num="8" type="O"/>
      <io base="0x98" num="8" type="I"/>
      <version>V9938</version>
      <vram>128</vram>
    </VDP>
    <PSG id="PSG">
      <type>YM2149</type>
      <io base="0xA0" num="8" type="IO"/>
      <sound><volume>21000</volume></sound>
      <ignorePortDirections>true</ignorePortDirections>
    </PSG>
    <RTC id="Real time clock">
      <io base="0xB4" num="2" type="O"/>
      <io base="0xB5" num="1" type="I"/>
      <sramname>roms_msx2.cmos</sramname>
    </RTC>
    <PrinterPort id="Printer Port">
      <io base="0x90" num="8" type="IO"/>
      <status_readable_on_all_ports>true</status_readable_on_all_ports>
      <unused_bits>0x00</unused_bits>
    </PrinterPort>
  </devices>
</msxconfig>
