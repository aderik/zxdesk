<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>
  <!-- A 50 Hz, 64K MSX1 on the generic MSX.ROM BIOS from msx/roms/ (the
       Philips VG 8020 config with the ROM swapped: openMSX knows no
       machine with this dump, so it gets a config of its own). -->
  <info>
    <manufacturer>MSX Desk</manufacturer>
    <code>Roms MSX1</code>
    <release_year>1985</release_year>
    <description>Generic European MSX1, 64kB, on the BIOS in msx/roms.</description>
    <type>MSX</type>
    <region>eu</region>
  </info>
  <CassettePort/>
  <devices>
    <PPI id="ppi">
      <sound><volume>16000</volume></sound>
      <io base="0xA8" num="8"/>
      <keyboard_type>int</keyboard_type>
      <has_keypad>false</has_keypad>
      <key_ghosting_sgc_protected>true</key_ghosting_sgc_protected>
      <code_kana_locks>false</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>
    <VDP id="VDP">
      <version>TMS9929A</version>
      <io base="0x98" num="8"/>
      <saturationPr>75</saturationPr>
      <saturationPb>50</saturationPb>
    </VDP>
    <PSG id="PSG">
      <type>YM2149</type>
      <sound><volume>21000</volume></sound>
      <io base="0xA0" num="4" type="IO"/>
      <ignorePortDirections>false</ignorePortDirections>
    </PSG>
    <PrinterPort id="Printer Port">
      <io base="0x90" num="2"/>
    </PrinterPort>
    <primary slot="0">
      <ROM id="MSX BIOS with BASIC ROM">
        <rom>
          <filename>MSX.ROM</filename>
          <sha1>409e82adac40f6bdd18eb6c84e8b2fbdc7fb5498</sha1>
        </rom>
        <mem base="0x0000" size="0x8000"/>
      </ROM>
    </primary>
    <primary external="true" slot="1"/>
    <primary external="true" slot="2"/>
    <primary slot="3">
      <RAM id="Main RAM">
        <mem base="0x0000" size="0x10000"/>
      </RAM>
    </primary>
  </devices>
</msxconfig>
